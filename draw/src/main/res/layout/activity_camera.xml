<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_camera"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/fl_camera_frame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:keepScreenOn="true"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />

        <com.example.draw.camera.view.FaceOverlayView
            android:id="@+id/face_overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <com.example.draw.camera.view.FrameOverlayView
            android:id="@+id/overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <View
            android:id="@+id/view_focus_indicator"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_camera_focus_ring"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ll_zoom_controls"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_camera_control_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/tv_zoom_wide"
                android:layout_width="46dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="0.5"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_zoom_main"
                android:layout_width="46dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_camera_zoom_selected"
                android:gravity="center"
                android:text="1x"
                android:textColor="#FFD600"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_zoom_2x"
                android:layout_width="46dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="2x"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/view_top_shade"
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:background="#66000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view_bottom_shade"
        android:layout_width="0dp"
        android:layout_height="190dp"
        android:background="#66000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/fl_top_camera"
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#252527"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_top_tools"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#303033"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#22FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <FrameLayout
                    android:id="@+id/card_night"
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="☾"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/card_flash"
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <TextView
                        android:id="@+id/tv_flash"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="⚡"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/card_timer"
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <TextView
                        android:id="@+id/tv_timer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="0s"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/card_tools"
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="⠿"
                        android:textColor="#FFFFFF"
                        android:textSize="23sp" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/fl_bottom_camera"
        android:layout_width="0dp"
        android:layout_height="190dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/ll_main_controls"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_capture"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="40dp"
                app:cardElevation="0dp"
                app:strokeColor="#666666"
                app:strokeWidth="4dp">

                <View
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_camera_capture_white" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_gallery"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="26dp"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="#29292C"
                app:cardCornerRadius="25dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="15dp"
                    android:src="@drawable/img_40"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_switch_camera"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="26dp"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="#29292C"
                app:cardCornerRadius="25dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="15dp"
                    android:src="@drawable/img_41"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    app:tint="@color/black" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mode_selector"
                android:layout_width="150dp"
                android:layout_height="46dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#222225"
                app:cardCornerRadius="23dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/tv_mode_video"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="VIDEO"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_mode_photo"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_camera_mode_selected"
                        android:gravity="center"
                        android:text="ẢNH"
                        android:textColor="#FFD600"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </FrameLayout>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/progress_camera"
        android:layout_width="70dp"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="@id/fl_camera_frame"
        app:layout_constraintEnd_toEndOf="@id/fl_camera_frame"
        app:layout_constraintStart_toStartOf="@id/fl_camera_frame"
        app:layout_constraintTop_toTopOf="@id/fl_camera_frame"
        app:lottie_autoPlay="true"
        app:lottie_fileName="anim_loading.json"
        app:lottie_loop="true"
        app:lottie_repeatMode="reverse" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_tools_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#F0303033"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/fl_bottom_camera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#44FFFFFF"
        app:strokeWidth="1dp">

        <GridLayout
            android:id="@+id/grid_tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:paddingStart="10dp"
            android:paddingTop="14dp"
            android:paddingEnd="10dp"
            android:paddingBottom="14dp"
            android:useDefaultMargins="true">

            <LinearLayout
                android:id="@+id/tool_flash"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    app:cardBackgroundColor="#1D1D20"
                    app:cardCornerRadius="29dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="⚡"
                        android:textColor="#FFFFFF"
                        android:textSize="23sp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="FLASH"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tool_style"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    app:cardBackgroundColor="#1D1D20"
                    app:cardCornerRadius="29dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="◎"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="PHONG CÁCH"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tool_timer"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    app:cardBackgroundColor="#1D1D20"
                    app:cardCornerRadius="29dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="◷"
                        android:textColor="#FFFFFF"
                        android:textSize="27sp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="HẸN GIỜ"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tool_exposure"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    app:cardBackgroundColor="#1D1D20"
                    app:cardCornerRadius="29dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="±"
                        android:textColor="#FFFFFF"
                        android:textSize="29sp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="PHƠI SÁNG"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_filter"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    app:cardBackgroundColor="#1D1D20"
                    app:cardCornerRadius="29dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="AI"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="AI FILTER"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tool_filter"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    app:cardBackgroundColor="#1D1D20"
                    app:cardCornerRadius="29dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="◉"
                        android:textColor="#FFFFFF"
                        android:textSize="25sp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="BỘ LỌC"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tool_frame"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_camera_size"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    app:cardBackgroundColor="#1D1D20"
                    app:cardCornerRadius="29dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/tv_camera_size"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="4:3"
                        android:textColor="#FFD600"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="KHUNG HÌNH"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tool_grid"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_grid"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    app:cardBackgroundColor="#1D1D20"
                    app:cardCornerRadius="29dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/tv_grid"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="▦"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="LƯỚI"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </GridLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/ll_brightness"
        android:layout_width="250dp"
        android:layout_height="44dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_camera_control_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/fl_bottom_camera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="☀"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/seek_exposure"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:progressTint="#FFD600"
            android:thumbTint="#FFD600" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_color_filter_controls"
        android:layout_width="0dp"
        android:layout_height="104dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_camera_tools_panel"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/fl_bottom_camera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_color_filter_back"
                android:layout_width="46dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="29sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Bộ lọc"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="46dp"
                android:layout_height="36dp" />

        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/tv_filter_original"
                    style="@style/CameraFilterCategory"
                    android:text="GỐC" />

                <TextView
                    android:id="@+id/tv_filter_warm"
                    style="@style/CameraFilterCategory"
                    android:text="ẤM" />

                <TextView
                    android:id="@+id/tv_filter_cool"
                    style="@style/CameraFilterCategory"
                    android:text="LẠNH" />

                <TextView
                    android:id="@+id/tv_filter_bw"
                    style="@style/CameraFilterCategory"
                    android:text="ĐEN TRẮNG" />

                <TextView
                    android:id="@+id/tv_filter_vintage"
                    style="@style/CameraFilterCategory"
                    android:text="VINTAGE" />

                <TextView
                    android:id="@+id/tv_filter_fade"
                    style="@style/CameraFilterCategory"
                    android:text="FADE" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_filter_controls"
        android:layout_width="0dp"
        android:layout_height="170dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_camera_tools_panel"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/fl_bottom_camera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_filter_back"
                android:layout_width="46dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="29sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="AI Filter"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="46dp"
                android:layout_height="40dp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/tv_filter_head"
                    style="@style/CameraFilterCategory"
                    android:text="Head" />

                <TextView
                    android:id="@+id/tv_filter_face"
                    style="@style/CameraFilterCategory"
                    android:text="Face" />

                <TextView
                    android:id="@+id/tv_filter_eyes"
                    style="@style/CameraFilterCategory"
                    android:text="Eyes" />

                <TextView
                    android:id="@+id/tv_filter_nose"
                    style="@style/CameraFilterCategory"
                    android:text="Nose" />

                <TextView
                    android:id="@+id/tv_filter_mouth"
                    style="@style/CameraFilterCategory"
                    android:text="Mouth" />
            </LinearLayout>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_filters"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>