<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <FrameLayout
        android:id="@+id/editorViewport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_editor_workspace"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/fl_bottom_tool"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/fl_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_transparent_checker">

            <ImageView
                android:id="@+id/iv_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />

            <com.example.draw.MoveAndLine
                android:id="@+id/drawingView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.example.draw.sticker.view.StickerView
                android:id="@+id/sv_sticker"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <com.yalantis.ucrop.view.UCropView
            android:id="@+id/uCropView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_circle_white"
        android:padding="10dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#222222" />

    <TextView
        android:id="@+id/tv_save"
        android:layout_width="70dp"
        android:layout_height="42dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_save"
        android:gravity="center"
        android:text="Save"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btn_undo"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_circle_white"
        android:padding="10dp"
        android:src="@drawable/img_13"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/btn_tick"
        app:layout_constraintEnd_toStartOf="@id/btn_redo"
        app:layout_constraintTop_toTopOf="@id/btn_tick" />

    <ImageView
        android:id="@+id/btn_tick"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_save"
        android:padding="10dp"
        android:src="@drawable/img_29"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <ImageView
        android:id="@+id/btn_redo"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_circle_white"
        android:padding="10dp"
        android:src="@drawable/img_14"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/btn_tick"
        app:layout_constraintEnd_toStartOf="@id/btn_tick"
        app:layout_constraintTop_toTopOf="@id/btn_tick" />

    <FrameLayout
        android:id="@+id/fl_bottom_tool"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="28dp"
        android:background="#00000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/fl_tool"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/ll_main_tool"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_sticker_tool"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="visible">

                <LinearLayout
                    android:id="@+id/ll_add_text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_add_text"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/img_1"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tv_add_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Add Text"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_sticker"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_sticker"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/img_2"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tv_sticker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Sticker"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_crop"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_crop"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/img_27"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tv_crop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Crop"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_draw_main"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_adjust"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/img_28"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tv_draw"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Draw"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_text_font_tool"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_sticker_tool"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_back_font"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/white" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_font"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_text_tool"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_sticker_tool"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ll_text_back"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_text_back"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_back"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tv_text_back"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/font_bold"
                        android:text="Back"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_text_color"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_text_color"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/img_9" />

                    <TextView
                        android:id="@+id/tv_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/font_bold"
                        android:text="Color"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_text_size"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_icon_size"
                        android:layout_width="40dp"
                        android:layout_height="34dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="Tᵀ"
                        android:textColor="@color/white"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/tv_text_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/font_bold"
                        android:text="Size"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_text_stroke"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_icon_stroke"
                        android:layout_width="40dp"
                        android:layout_height="34dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="T"
                        android:textColor="@color/white"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/tv_text_stroke"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/font_bold"
                        android:text="Stroke"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_text_font"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_icon_font"
                        android:layout_width="50dp"
                        android:layout_height="34dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="Aa"
                        android:textColor="@color/white"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/tv_text_font"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/font_bold"
                        android:text="Font"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_text_size_tool"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_sticker_tool"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_back_size"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tv_size_small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="A"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <SeekBar
                    android:id="@+id/sb_text_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:min="10"
                    android:progress="50"
                    android:progressTint="#D39B32"
                    android:thumbTint="@color/white" />

                <TextView
                    android:id="@+id/tv_size_big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    android:textColor="@color/white"
                    android:textSize="30sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_text_stroke_tool"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_sticker_tool"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_back_stroke"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/white" />

                <View
                    android:id="@+id/v_stroke_color"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_stroke_color" />

                <SeekBar
                    android:id="@+id/sb_text_stroke"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:max="20"
                    android:progress="0"
                    android:progressTint="#D39B32"
                    android:thumbTint="@color/white" />

                <TextView
                    android:id="@+id/tv_stroke_value"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_sticker_tool"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@drawable/bg_sticker_tool"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:fillViewport="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_back_sticker"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:padding="8dp"
                            android:src="@drawable/ic_back"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_sticker_all"
                            android:layout_width="58dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_sticker_category"
                            android:gravity="center"
                            android:text="All"
                            android:textColor="#D39B32"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_sticker_emoji"
                            android:layout_width="66dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_sticker_category"
                            android:gravity="center"
                            android:text="Emoji"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_sticker_nature"
                            android:layout_width="70dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_sticker_category"
                            android:gravity="center"
                            android:text="Nature"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_sticker_art"
                            android:layout_width="58dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_sticker_category"
                            android:gravity="center"
                            android:text="Art"
                            android:textColor="@color/white"
                            android:textSize="13sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_sticker"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_Crop_tool"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_sticker_tool"
                android:elevation="10dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:fillViewport="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_back_crop"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="20dp"
                            android:padding="8dp"
                            android:src="@drawable/ic_back"
                            app:tint="@color/white" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_crop"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="8dp"
                            android:clipToPadding="false"
                            android:overScrollMode="never"
                            android:scrollbars="none" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_adjust_tool"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_sticker_tool"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adjust View"
                    android:textColor="@color/white" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/ll_draw"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_toolbar"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="14dp"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:id="@+id/iv_back_draw"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_back" />

                    <ImageView
                        android:id="@+id/btnPencil"
                        android:layout_width="58dp"
                        android:layout_height="90dp"
                        android:layout_marginTop="20dp"
                        android:src="@drawable/img_but_1" />

                    <ImageView
                        android:id="@+id/btnPen"
                        android:layout_width="58dp"
                        android:layout_height="90dp"
                        android:layout_marginTop="20dp"
                        android:src="@drawable/img_cay_but_2" />

                    <ImageView
                        android:id="@+id/btnMarker"
                        android:layout_width="58dp"
                        android:layout_height="90dp"
                        android:layout_marginTop="20dp"
                        android:src="@drawable/img_cay_but_3" />

                    <ImageView
                        android:id="@+id/btnEraser"
                        android:layout_width="58dp"
                        android:layout_height="90dp"
                        android:layout_marginTop="20dp"
                        android:src="@drawable/img_cay_but_4" />

                    <ImageView
                        android:id="@+id/btnPen5"
                        android:layout_width="58dp"
                        android:layout_height="90dp"
                        android:layout_marginTop="20dp"
                        android:src="@drawable/img_cay_but_5" />
                </LinearLayout>
            </HorizontalScrollView>

            <FrameLayout
                android:id="@+id/btnColor"
                android:layout_width="58dp"
                android:layout_height="78dp">

                <View
                    android:id="@+id/colorCircle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_color_circle" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btnAdd"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_gray"
                android:padding="15dp"
                android:src="@drawable/ic_plus" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>